rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Checks relationship between athlete and member
    function getRel(athleteId, memberId) {
      return get(/databases/$(database)/documents/relationships/$(athleteId + '_' + memberId));
    }

    function hasActiveRel(athleteId, memberId) {
      return exists(/databases/$(database)/documents/relationships/$(athleteId + '_' + memberId)) &&
             getRel(athleteId, memberId).data.status == 'active';
    }

    // Module permission readers
    function canReadModule(athleteId, moduleName) {
      return isUser(athleteId) || (
        isAuthenticated() &&
        hasActiveRel(athleteId, request.auth.uid) &&
        (getRel(athleteId, request.auth.uid).data.permissions[moduleName] == 'read' ||
         getRel(athleteId, request.auth.uid).data.permissions[moduleName] == 'write')
      );
    }

    function canWriteModule(athleteId, moduleName) {
      return isUser(athleteId) || (
        isAuthenticated() &&
        hasActiveRel(athleteId, request.auth.uid) &&
        getRel(athleteId, request.auth.uid).data.permissions[moduleName] == 'write'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false; // Soft deletes / Cloud Function only
    }

    // 2. Athletes collection & athlete profile document
    match /athletes/{athleteId} {
      // Athlete has full access to own profile
      // Active member with active relationship can read athlete profile
      allow read: if isUser(athleteId) || hasActiveRel(athleteId, request.auth.uid);
      allow create, update: if isUser(athleteId);
      allow delete: if false;

      // Subcollection: days (RECOVERY module)
      match /days/{date} {
        allow read: if canReadModule(athleteId, 'recovery');
        allow write: if canWriteModule(athleteId, 'recovery');
      }

      // Subcollection: sessions (TRAINING module)
      match /sessions/{sessionId} {
        allow read: if canReadModule(athleteId, 'training');
        allow write: if canWriteModule(athleteId, 'training');
      }

      // Subcollection: plannedWorkouts (TRAINING module)
      match /plannedWorkouts/{workoutId} {
        allow read: if canReadModule(athleteId, 'training');
        allow write: if canWriteModule(athleteId, 'training');
      }

      // Subcollection: nutritionDays and /entries (NUTRITION module)
      match /nutritionDays/{date} {
        allow read: if canReadModule(athleteId, 'nutrition');
        allow write: if canWriteModule(athleteId, 'nutrition');

        match /entries/{entryId} {
          allow read: if canReadModule(athleteId, 'nutrition');
          allow write: if canWriteModule(athleteId, 'nutrition');
        }
      }

      // Subcollection: injuries (HEALTH module - strictly blocked unless health: 'read' | 'write')
      match /injuries/{injuryId} {
        allow read: if canReadModule(athleteId, 'health');
        allow write: if canWriteModule(athleteId, 'health');
      }

      // Subcollection: measurements (HEALTH module)
      match /measurements/{measurementId} {
        allow read: if canReadModule(athleteId, 'health');
        allow write: if canWriteModule(athleteId, 'health');
      }

      // Subcollection: notes (HEALTH module)
      match /notes/{noteId} {
        allow read: if canReadModule(athleteId, 'health');
        allow write: if canWriteModule(athleteId, 'health');
      }

      // Subcollection: devices (DEVICES module)
      match /devices/{deviceId} {
        allow read: if canReadModule(athleteId, 'devices');
        allow write: if canWriteModule(athleteId, 'devices');
      }
    }

    // 3. Relationships collection (relationships/{relId})
    // relId convention is ${athleteId}_${memberId}
    match /relationships/{relId} {
      // Both the athlete and the member can read their relationship document
      allow read: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        resource.data.memberId == request.auth.uid
      );

      // Create: athlete can create, or member with matching ID on invite accept
      allow create: if isAuthenticated() && (
        request.resource.data.athleteId == request.auth.uid ||
        request.resource.data.memberId == request.auth.uid
      );

      // Update: ONLY THE ATHLETE can modify permissions or status.
      // Members cannot modify permissions or status of their relationship!
      allow update: if isAuthenticated() &&
        resource.data.athleteId == request.auth.uid &&
        request.resource.data.athleteId == request.auth.uid;

      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;

      // Audit log subcollection: relationships/{relId}/log/{logId}
      // Strictly visible to the athlete
      match /log/{logId} {
        allow read: if isAuthenticated() &&
          get(/databases/$(database)/documents/relationships/$(relId)).data.athleteId == request.auth.uid;
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/relationships/$(relId)).data.athleteId == request.auth.uid ||
          get(/databases/$(database)/documents/relationships/$(relId)).data.memberId == request.auth.uid
        );
        allow update, delete: if false; // Append-only audit log
      }
    }

    // 4. Threads & Messages
    match /threads/{threadId} {
      allow read: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if isAuthenticated() && (
        request.resource.data.athleteId == request.auth.uid ||
        request.auth.uid in request.resource.data.participantIds
      );
      allow update: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        request.auth.uid in resource.data.participantIds
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds
        );
        allow update, delete: if false;
      }
    }

    // 5. Invites collection
    match /invites/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.athleteId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        (request.resource.data.status == 'accepted')
      );
      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
